{
  "manifest_version": 2,
  "id": "com.0-hz.rss-reader",
  "version": "0.4.3",
  "name": "麦麦 RSS 阅读器",
  "description": "订阅 RSS 源，将新内容注入 Maisaka 上下文并触发主动处理；提供 Tool 与 /rss 命令供麦麦与用户查阅订阅。",
  "author": {
    "name": "kes",
    "url": "https://github.com/yufei-pan"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/yufei-pan/MaiBot-rss-reader",
    "homepage": "https://github.com/yufei-pan/MaiBot-rss-reader",
    "documentation": "https://github.com/yufei-pan/MaiBot-rss-reader/blob/main/README.md",
    "issues": "https://github.com/yufei-pan/MaiBot-rss-reader/issues"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.5.1",
    "max_version": "2.99.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "feedparser",
      "version_spec": ">=6.0.0"
    }
  ],
  "capabilities": [
    "maisaka.context.append",
    "maisaka.proactive.trigger",
    "send.text",
    "config.get"
  ],
  "i18n": {
    "default_locale": "zh-CN"
  }
}
